# Optional OFFLINE AI enrichment. Keep the API key only in .env/Kaggle Secrets.
VN_LABOR_OFFLINE_AI_PROVIDER=ollama
VN_LABOR_OFFLINE_AI_URL=http://127.0.0.1:11434/api/chat
VN_LABOR_OFFLINE_AI_MODEL=qwen3:8b
VN_LABOR_OFFLINE_AI_TIMEOUT_SECONDS=300
# VN_LABOR_OFFLINE_AI_API_KEY=replace_me

# Neo4j is optional until the last step.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me
NEO4J_DATABASE=neo4j

# Ollama is optional. Heuristic Diagnostic Checklists work without it.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:4b

# ONLINE artifact/config. VN_LABOR_ARTIFACT_SOURCE overrides artifact_source
# in config/online*.yaml, which keeps deployments portable across machines.
VN_LABOR_ONLINE_CONFIG=config/online.yaml
VN_LABOR_ARTIFACT_SOURCE=build/releases/vn_labor_results_v8_1_aura.zip
VN_LABOR_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
VN_LABOR_ONLINE_CACHE=.cache/online

# Optional ontology-alignment Researcher. Its output expands retrieval only;
# it can never approve evidence or invent confirmed facts.
VN_LABOR_RESEARCHER_MODE=deterministic
VN_LABOR_RESEARCHER_URL=http://127.0.0.1:11434/api/chat
VN_LABOR_RESEARCHER_MODEL=qwen3:8b
VN_LABOR_RESEARCHER_MAX_QUERIES=2
# VN_LABOR_RESEARCHER_API_KEY=replace_me
# VN_LABOR_RESEARCHER_HEALTH_URL=https://your-gateway.example/ready

# Optional structured legal-applicability auditor. Keep deterministic unless
# an Ollama/HTTP model has been evaluated against approved legal Gold data.
VN_LABOR_APPLICABILITY_MODE=deterministic
VN_LABOR_APPLICABILITY_URL=http://127.0.0.1:11434/api/chat
VN_LABOR_APPLICABILITY_MODEL=qwen3:8b
# Set mode=hybrid to combine hard rules with checklist-aware model auditing.
VN_LABOR_APPLICABILITY_PROVIDER=ollama
VN_LABOR_APPLICABILITY_MAX_ITEMS=10

# Optional structured adjudicator. It receives only the Verified Evidence Pack;
# provider failures fall back to the grounded deterministic adjudicator.
VN_LABOR_ADJUDICATION_MODE=deterministic
VN_LABOR_ADJUDICATION_URL=http://127.0.0.1:11434/api/chat
VN_LABOR_ADJUDICATION_MODEL=qwen3:4b
# VN_LABOR_ADJUDICATION_API_KEY=replace_me
# VN_LABOR_ADJUDICATION_HEALTH_URL=https://your-gateway.example/ready


# Optional: protect the complete FastAPI backend when exposed through a tunnel.
# Use a random value of at least 32 bytes and store it only in .env/Kaggle Secrets.
VN_LABOR_API_KEY=
# Keep 1 on memory-constrained machines and Kaggle; raise only after load testing.
VN_LABOR_MAX_CONCURRENT_ANSWERS=1
