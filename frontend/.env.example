# Local backend (default)
VITE_BACKEND_TARGET=http://127.0.0.1:8000

# For a remote Kaggle/ngrok backend, replace the target and set the same secret
# stored as VN_LABOR_API_KEY in Kaggle Secrets. BACKEND_PROXY_TOKEN has no
# VITE_ prefix and is never embedded into browser code.
BACKEND_PROXY_TOKEN=

# Keep these above the backend's total budget (default 180 seconds).
VITE_API_TIMEOUT_MS=210000
BACKEND_PROXY_TIMEOUT_MS=220000
