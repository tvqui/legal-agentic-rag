    "TD003": {
      "status_score_eligible": false,
      "qa_judge_eligible": false,
      "note": "Cần duyệt lại nhãn bắt buộc hỏi vùng/ngày. Ngày tra cứu đã được cung cấp. Nếu 6 triệu là lương công việc theo tháng cho đủ giờ bình thường thì cao hơn mức tối thiểu tháng cao nhất 5,31 triệu theo khoản 1 Điều 3 Nghị định 293/2025/NĐ-CP. Vùng không luôn là dữ kiện quyết định trong ví dụ số tiền này. Vẫn cần làm rõ thành phần lương/giờ làm, không đồng nhất đủ lương tối thiểu với mọi khía cạnh trả lương hợp pháp.",
      "source": "https://xaydungchinhsach.chinhphu.vn/nghi-dinh-so-293-2025-nd-cp-quy-dinh-muc-luong-toi-thieu-doi-voi-nguoi-lao-dong-lam-viec-theo-hop-dong-lao-dong-119251110172808433.htm"
    },
    "HD007": {
