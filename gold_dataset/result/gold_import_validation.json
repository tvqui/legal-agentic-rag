    },
    "TV004": {
      "note": "Giữ điều kiện loại trừ chức danh người quản lý doanh nghiệp; đáp án đã có điều kiện này."
    },
    "NP005": {
      "note": "12 ngày là mức cơ bản của nhóm thông thường; cần cho phép câu trả lời nêu tuổi, khuyết tật, thâm niên khi thích hợp, không phạt một điều kiện đúng chỉ vì đáp án ngắn."
    },
    "CD007": {
