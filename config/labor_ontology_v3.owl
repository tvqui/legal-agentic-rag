    <labor:provisionText xml:lang="vi">Ví dụ theo tài liệu hướng dẫn: người lao động được đơn phương chấm dứt không cần báo trước nếu không được trả đủ lương hoặc trả lương không đúng thời hạn, trừ trường hợp quy định tại khoản 4 Điều 97.</labor:provisionText>
    <labor:provisionReferencesProvision rdf:resource="https://example.org/legalgraphrag-vn/ontology#PROV_BLLD2019_ART97_CL4"/>
    <labor:provisionExpressesNorm rdf:resource="https://example.org/legalgraphrag-vn/ontology#NORM_ART35_CL2_PTB"/>
    <labor:provisionHasChecklist rdf:resource="https://example.org/legalgraphrag-vn/ontology#CHK_ART35_CL2_PTB"/>
  </rdf:Description>
